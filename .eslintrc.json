{
  "env": {
    "browser": true,
    "es2021": true
  },
  "extends": "eslint:recommended",
  "parserOptions": {
    "ecmaVersion": 2021,
    "sourceType": "script"
  },
  "globals": {
    "CONFIG": "readonly",
    "LEVEL_DATA": "readonly",
    "DIFFICULTY_SCALING": "readonly",
    "LEVEL_THEMES": "readonly",
    "Utils": "readonly",
    "ErrorHandler": "readonly",
    "errorHandler": "readonly",
    "StorageManager": "readonly",
    "SettingsManager": "readonly",
    "settingsManager": "writable",
    "AchievementsManager": "readonly",
    "achievementsManager": "writable",
    "AchievementsUI": "readonly",
    "achievementsUI": "writable",
    "PerformanceMonitor": "readonly",
    "Camera": "readonly",
    "SpatialGrid": "readonly",
    "CollisionManager": "readonly",
    "TouchControls": "readonly",
    "Physics": "readonly",
    "PlayerPhysics": "readonly",
    "Player": "readonly",
    "Enemy": "readonly",
    "Goomba": "readonly",
    "Koopa": "readonly",
    "PiranhaPlant": "readonly",
    "Buzzy": "readonly",
    "PowerUp": "readonly",
    "Mushroom": "readonly",
    "FireFlower": "readonly",
    "Coin": "readonly",
    "Star": "readonly",
    "OneUp": "readonly",
    "Level": "readonly",
    "Particle": "readonly",
    "ParticleSystem": "readonly",
    "SoundManager": "readonly",
    "Game": "readonly",
    "game": "writable"
  },
  "rules": {
    "indent": ["error", 4],
    "linebreak-style": ["error", "unix"],
    "quotes": ["error", "single", { "avoidEscape": true }],
    "semi": ["error", "always"],
    "no-unused-vars": ["warn", { "argsIgnorePattern": "^_" }],
    "no-console": ["warn", { "allow": ["warn", "error"] }],
    "curly": ["error", "all"],
    "brace-style": ["error", "1tbs"],
    "eqeqeq": ["error", "always"],
    "no-var": "error",
    "prefer-const": "warn",
    "prefer-arrow-callback": "warn",
    "no-trailing-spaces": "error",
    "no-multiple-empty-lines": ["error", { "max": 2 }],
    "space-before-function-paren": ["error", {
      "anonymous": "never",
      "named": "never",
      "asyncArrow": "always"
    }],
    "comma-dangle": ["error", "never"],
    "no-param-reassign": "warn",
    "no-shadow": "warn",
    "prefer-template": "warn",
    "no-useless-concat": "error",
    "object-shorthand": "warn",
    "max-len": ["warn", { "code": 120, "ignoreComments": true }],
    "consistent-return": "warn",
    "default-case": "warn"
  }
}
